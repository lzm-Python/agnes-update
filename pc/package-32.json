{
  "name": "agnes-workbench",
  "version": "1.0.0",
  "description": "Agnes 工作台 电脑版",
  "main": "main.js",
  "author": "Agnes",
  "license": "UNLICENSED",
  "scripts": {
    "sync": "node sync.js",
    "start": "node sync.js && electron .",
    "dist": "node sync.js && electron-builder --win nsis portable --ia32"
  },
  "devDependencies": {
    "electron": "21.4.4",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.agnes.workbench",
    "productName": "AgnesWorkbench",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        },
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agnes 工作台"
    }
  }
}

